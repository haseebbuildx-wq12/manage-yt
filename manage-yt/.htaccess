RewriteEngine On
RewriteBase /
Options -Indexes

RewriteRule ^(app|config|database|storage|vendor|cron)(/|$) - [F,L]
RewriteRule ^\.git(/.*)?$ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<FilesMatch "^\.(env|git)">
    Require all denied
</FilesMatch>