Options -Indexes
RewriteEngine On

# Never expose application internals, credentials, logs, SQL, temp files or cron scripts.
RewriteRule ^(?:app|config|database|cron|storage)(?:/|$) - [F,L,NC]
RewriteRule ^(?:\.git|\.env|composer\.(?:json|lock)|.*\.sql)$ - [F,L,NC]

# Allow real files/directories; route unknown paths to the dashboard.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
